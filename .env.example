# Copy to .env.local and fill in. NEVER commit real credentials.
# The IAM principal behind these keys should be least-privilege:
# only dynamodb:Query + dynamodb:GetItem on the table and its Inverted-Index.
ACCESS_KEY=
SECRET_KEY=
REGION=
TABLE_NAME=

# Optional. Where portrait images are served from. Leave unset to use the
# bundled /public/portraits folder. To serve from a CDN / object store, set
# this to the base URL the images live under (no trailing slash), e.g.
# NEXT_PUBLIC_IMAGE_BASE_URL=https://cdn.example.com/portraits
# See "Image hosting" in the README. This var is public (NEXT_PUBLIC_*).
NEXT_PUBLIC_IMAGE_BASE_URL=
